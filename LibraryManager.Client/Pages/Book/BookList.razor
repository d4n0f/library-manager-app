@page "/books"
@using LibraryManager.Shared.Models
@using LibraryManager.Client.Interfaces
@inject IBookService BookService
@using Microsoft.AspNetCore.Authorization;
@attribute [Authorize]
@inject HttpClient Http
@inject TokenProvider TokenProvider

<h3>Könyvek</h3>

@if (userRole == "Admin")
{
    <div class="mb-3">
        <a href="/books/add" class="btn btn-primary">Könyv hozzáadása</a>
    </div>
}

@if (_books is not null)
{
    <table class="table table-hover border">
        <thead>
            <tr>
                <th>Leltári szám</th>
                <th>Cím</th>
                <th>Szerző</th>
                <th>Kiadó</th>
                <th>Kiadás éve</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in _books)
            {
                <tr>
                    <td>@book.InventoryNumber</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.Publisher</td>
                    <td>@book.PublicationYear</td>
                    @if (userRole == "Admin")
                    {
                        <td>
                            <a href="/books/update/@book.InventoryNumber">
                                Frissítés
                            </a>
                        </td>
                        <td>
                            <a href="/books/remove/@book.InventoryNumber">
                                Törlés
                            </a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Betöltés...</p>
}

@code {
    private List<Book> _books;
    private string? userRole;

    protected override async Task OnInitializedAsync()
    {
        _books = await BookService.GetAllBooksAsync();

        var token = await TokenProvider.GetTokenAsync();

        if (!string.IsNullOrEmpty(token))
        {
            Http.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            try
            {
                userRole = await Http.GetStringAsync("/api/auth/role");
                Console.WriteLine($"Felhasználó szerepe: {userRole}");
            }
            catch (Exception ex)
            {
                Console.WriteLine("Szerepkör lekérés hiba: " + ex.Message);
                userRole = null;
            }
        }
    }
}
