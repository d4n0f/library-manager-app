@page "/rentals/return/{readerNumber:int}/{inventoryNumber:int}"
@using LibraryManager.Shared.Models
@using LibraryManager.Client.Interfaces
@inject IRentalService RentalService
@inject NavigationManager NavigationManager

<h3>Könyv hozzáadása</h3>

<button class="btn btn-primary" @onclick="ReturnBookAsync">Visszahozás</button>

<div class="mb-3" style="margin-top: 1em">
    <a href="/rentals" class="btn btn-primary">Mégse</a>
</div>

@code {
    [Parameter]
    public int ReaderNumber { get; set; }

    [Parameter]
    public int InventoryNumber { get; set; }

    private async Task ReturnBookAsync()
    {
        await RentalService.ReturnBookAsync(ReaderNumber, InventoryNumber);
        NavigationManager.NavigateTo("/rentals");
    }
}