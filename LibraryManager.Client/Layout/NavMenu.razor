<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
            <a class="navbar-brand" href="">
                <img src="/img/konyvtar_kezelo_logo_szoveggel.png" alt="Könyvtár logo" />
            </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Főoldal
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/books" Match="NavLinkMatch.All">
                <span class="" aria-hidden="true"></span> Könyvek
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/readers" Match="NavLinkMatch.All">
                <span class="" aria-hidden="true"></span> Olvasók
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/rentals" Match="NavLinkMatch.All">
                <span class="" aria-hidden="true"></span> Kölcsönzések
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
